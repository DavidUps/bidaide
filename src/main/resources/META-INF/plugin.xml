<idea-plugin>
    <id>com.bidaide</id>
    <name>Bidaide</name>
    <vendor>David Arribas</vendor>
    <description><![CDATA[
        GitHub (pull requests, issues, open in GitHub, gists) powered by the GitHub CLI, plus quick ADB operations
        for the app you are working on, in a single plugin.
        <br/><br/>
        In IntelliJ IDEA only the GitHub part is available. The ADB operations, installing APKs and testing a pull
        request on a device need Android Studio.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>
    <!-- ADB, APK installs and "Probar en dispositivo" live in bidaide-android.xml, loaded only in Android Studio.
         The condition is Android Studio itself and not org.jetbrains.android: the Android plugin IntelliJ IDEA can
         install has a different API from the one this plugin is built and verified against. -->
    <depends optional="true" config-file="bidaide-android.xml">com.intellij.modules.androidstudio</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Bidaide" displayType="BALLOON"/>
        <toolWindow id="Bidaide" anchor="bottom" icon="/icons/bidaide.svg" canCloseContents="true"
                    factoryClass="com.bidaide.github.toolwindow.BidaideToolWindowFactory"/>
        <postStartupActivity implementation="com.bidaide.github.current.CurrentBranchPrService$Startup"/>
        <statusBarWidgetFactory id="Bidaide.PrStatus" order="after gitWidget"
                                implementation="com.bidaide.github.current.PrStatusWidgetFactory"/>
        <diff.DiffExtension implementation="com.bidaide.github.review.PrReviewDiffExtension"/>
        <applicationConfigurable parentId="tools" id="com.bidaide.settings" displayName="Bidaide"
                                 instance="com.bidaide.settings.BidaideConfigurable"/>
    </extensions>

    <actions>
        <action id="Bidaide.Pr.AddComment" class="com.bidaide.github.review.AddPrCommentAction">
            <add-to-group group-id="Diff.EditorPopupMenu" anchor="first"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt C"/>
        </action>

        <group id="Bidaide.GitHub.File" text="Bidaide GitHub" popup="true" icon="AllIcons.Vcs.Vendors.Github">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
            <action id="Bidaide.GitHub.Open" class="com.bidaide.github.actions.OpenInGitHubAction" text="Abrir en GitHub"/>
            <action id="Bidaide.GitHub.CopyLink" class="com.bidaide.github.actions.CopyGitHubLinkAction"
                    text="Copiar enlace permanente de GitHub"/>
            <action id="Bidaide.GitHub.Gist" class="com.bidaide.github.actions.CreateGistAction" text="Crear gist..."/>
            <action id="Bidaide.GitHub.IssueFromSelection" class="com.bidaide.github.actions.CreateIssueFromSelectionAction"
                    text="Crear issue desde selección..."/>
            <action id="Bidaide.GitHub.LinePullRequest" class="com.bidaide.github.actions.FindPullRequestForLineAction"
                    text="¿Qué PR trajo esta línea?"/>
        </group>

        <group id="Bidaide.Menu" text="Bidaide" popup="true" icon="/icons/bidaide.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="Bidaide.GitHub.ToolWindow" class="com.bidaide.github.actions.ShowGitHubToolWindowAction"
                    text="Abrir ventana Bidaide" icon="/icons/bidaide.svg"/>
            <reference ref="Bidaide.GitHub.File"/>
            <group id="Bidaide.GitHub.Repo" text="GitHub" popup="true" icon="AllIcons.Vcs.Vendors.Github">
                <action id="Bidaide.GitHub.SearchCode" class="com.bidaide.github.actions.SearchGitHubCodeAction"
                        text="Buscar código en GitHub..."/>
                <action id="Bidaide.GitHub.SwitchAccount" class="com.bidaide.github.actions.SwitchGitHubAccountAction"
                        text="Cambiar cuenta de GitHub..."/>
                <action id="Bidaide.GitHub.Clone" class="com.bidaide.github.actions.CloneGitHubRepositoryAction"
                        text="Clonar repositorio..."/>
                <action id="Bidaide.GitHub.Publish" class="com.bidaide.github.actions.PublishToGitHubAction"
                        text="Publicar proyecto en GitHub..."/>
            </group>
        </group>
    </actions>
</idea-plugin>
